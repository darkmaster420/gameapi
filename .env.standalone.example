# GameSearch API v2 - Standalone Setup Environment Variables
# For use with docker-compose.standalone.yml
# Copy this file to .env and update FLARESOLVERR_URL

# ============================================
# FlareSolverr Configuration (REQUIRED)
# ============================================
# URL to your EXTERNAL FlareSolverr instance
# THIS IS REQUIRED - The API will not start without it
#
# Examples:
#   - Local: http://localhost:8191/v1
#   - Docker network: http://your-flaresolverr-container:8191/v1
#   - Remote server: http://192.168.1.100:8191/v1
#   - Cloud: https://your-flaresolverr.example.com/v1
FLARESOLVERR_URL=

# Timeout for FlareSolverr requests in milliseconds (default: 60000)
FLARE_TIMEOUT_MS=60000

# Number of retry attempts for FlareSolverr (default: 3)
FLARE_RETRIES=3

# ============================================
# Server Configuration
# ============================================
# Port to expose the API on your host (default: 3000)
PORT=3000

# Node environment (development/production)
NODE_ENV=production
