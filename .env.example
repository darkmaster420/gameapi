# GameSearch API v2 - Environment Variables Example
# Copy this file to .env and fill in your values

# ============================================
# FlareSolverr Configuration (REQUIRED)
# ============================================
# URL to your FlareSolverr instance
# For Docker Compose: use http://flaresolverr:8191/v1 (internal network)
# For local development: use http://localhost:8191/v1
# For external instance: use your public URL
FLARESOLVERR_URL=http://flaresolverr:8191/v1

# Timeout for FlareSolverr requests in milliseconds (default: 30000)
FLARE_TIMEOUT_MS=60000

# Number of retry attempts for FlareSolverr (default: 2)
FLARE_RETRIES=3

# ============================================
# Server Configuration
# ============================================
# Port for the Express server (default: 3000)
PORT=3000

# Node environment (development/production)
NODE_ENV=production
