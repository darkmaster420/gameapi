# GameSearch API v2 - Environment Variables Example
# Copy this file to .env and fill in your values

# ============================================
# FlareSolverr Configuration
# ============================================
# URL to your FlareSolverr instance
# - Complete setup: Automatically set to http://flaresolverr:8191/v1 (don't change)
# - Standalone setup: Set this to your external FlareSolverr URL (REQUIRED)
#
# Examples:
#   - Local: http://localhost:8191/v1
#   - Docker network: http://flaresolverr:8191/v1
#   - Remote server: http://192.168.1.100:8191/v1
#   - Cloud: https://your-flaresolverr.example.com/v1
FLARESOLVERR_URL=http://flaresolverr:8191/v1

# Timeout for FlareSolverr requests in milliseconds (default: 60000)
FLARE_TIMEOUT_MS=60000

# Number of retry attempts for FlareSolverr (default: 3)
FLARE_RETRIES=3

# ============================================
# FlareSolverr Service Configuration (for complete setup only)
# ============================================
# Log level for FlareSolverr (default: info)
# Options: debug, info, warn, error
FLARE_LOG_LEVEL=info

# Log HTML content (default: false)
FLARE_LOG_HTML=false

# Captcha solver (default: none)
# Options: none, hcaptcha-solver, harvester
FLARE_CAPTCHA_SOLVER=none

# ============================================
# Server Configuration
# ============================================
# Port to expose the API on your host (default: 3000)
PORT=3000

# Node environment (development/production)
NODE_ENV=production
